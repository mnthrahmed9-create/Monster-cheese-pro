<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>شطرنج الوحوش 3D - القائمة</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-tap-highlight-color: transparent; /* لمنع وميض الشاشة عند النقر في الموبايل */
        }

        body {
            background-color: #0a0514;
            overflow: hidden; /* منع التمرير */
            width: 100vw;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* الحاوية الرئيسية التي تحمل الصورة كخلفية */
        #ui-container {
            position: relative;
            width: 100%;
            height: 100%;
            /* هنا نستخدم الصورة كخلفية. تأكد أن الصورة في نفس المجلد واسمها menu.jpg */
            background-image: url('menu.jpg');
            background-size: cover; /* تغطي الشاشة بالكامل مع الحفاظ على التناسب */
            background-position: center center;
            background-repeat: no-repeat;
        }

        /* 
         * تنسيق الأزرار الشفافة.
         * حالياً جعلت لها حدود حمراء متقطعة (border) حتى تراها وتعدلها،
         * بمجرد التأكد من أماكنها، امسح سطر الـ border.
         */
        .hotspot {
            position: absolute;
            background-color: rgba(255, 0, 0, 0.01); /* شفافة جداً */
            border: 1px dashed rgba(255, 0, 0, 0.5); /* حدود للمساعدة في التعديل */
            cursor: pointer;
            border-radius: 10px;
            transition: background 0.1s;
            z-index: 10;
        }

        /* تأثير عند الضغط على الزر */
        .hotspot:active {
            background-color: rgba(255, 255, 255, 0.2);
        }

        /* 
         * =========================================
         * تحديد أماكن الأزرار بناءً على نسب الشاشة (Percentages)
         * =========================================
         */

        /* --- الشريط العلوي --- */
        .btn-profile-top { top: 2%; left: 2%; width: 35%; height: 7%; border-radius: 20px; }
        .btn-gold-plus   { top: 2%; left: 50%; width: 6%; height: 4%; border-radius: 50%; }
        .btn-gem-plus    { top: 2%; left: 67%; width: 6%; height: 4%; border-radius: 50%; }
        .btn-settings    { top: 2%; left: 80%; width: 8%; height: 5%; border-radius: 50%; }
        .btn-mail        { top: 2%; right: 3%; width: 8%; height: 5%; border-radius: 10px; }

        /* --- القائمة اليسرى --- */
        .btn-quests       { top: 32%; left: 3%; width: 18%; height: 6%; }
        .btn-achievements { top: 40.5%; left: 3%; width: 18%; height: 6%; }
        .btn-gifts        { top: 49%; left: 3%; width: 18%; height: 6%; }
        .btn-leaderboard  { top: 57.5%; left: 3%; width: 18%; height: 6%; }

        /* --- صندوق المكافآت اليومية (يمين) --- */
        .btn-daily-chest  { top: 32%; right: 3%; width: 30%; height: 26%; border-radius: 15px; }

        /* --- الزر الرئيسي الكبير --- */
        .btn-start-match  { bottom: 25%; left: 20%; width: 60%; height: 8%; border-radius: 30px; }

        /* --- الأزرار السفلية الثلاثة --- */
        .btn-play-online  { bottom: 12.5%; left: 3%; width: 29%; height: 8%; border-radius: 15px; }
        .btn-play-ai      { bottom: 12.5%; left: 35.5%; width: 29%; height: 8%; border-radius: 15px; }
        .btn-challenges   { bottom: 12.5%; right: 3%; width: 29%; height: 8%; border-radius: 15px; }

        /* --- شريط التنقل السفلي --- */
        .btn-nav-store    { bottom: 0; right: 76%; width: 24%; height: 9%; }
        .btn-nav-inventory{ bottom: 0; right: 51%; width: 24%; height: 9%; }
        .btn-nav-profile  { bottom: 0; right: 26%; width: 24%; height: 9%; }
        .btn-nav-home     { bottom: 0; right: 0; width: 24%; height: 9%; }

    </style>
</head>
<body>

    <div id="ui-container">
        
        <!-- ================== الأزرار الشفافة (Hotspots) ================== -->
        
        <!-- الشريط العلوي -->
        <div class="hotspot btn-profile-top" onclick="showMsg('الملف الشخصي', 'هنا تضع كود الملف الشخصي')"></div>
        <div class="hotspot btn-gold-plus" onclick="showMsg('ذهب', 'شراء ذهب')"></div>
        <div class="hotspot btn-gem-plus" onclick="showMsg('جواهر', 'شراء جواهر')"></div>
        <div class="hotspot btn-settings" onclick="openSettings()"></div>
        <div class="hotspot btn-mail" onclick="showMsg('الرسائل', 'ليس لديك رسائل جديدة')"></div>

        <!-- القائمة اليسرى -->
        <div class="hotspot btn-quests" onclick="showMsg('المهام اليومية', 'هنا كود المهام')"></div>
        <div class="hotspot btn-achievements" onclick="showMsg('الإنجازات', 'هنا كود الإنجازات')"></div>
        <div class="hotspot btn-gifts" onclick="showMsg('مكافآت خاصة', 'هنا كود المكافآت')"></div>
        <div class="hotspot btn-leaderboard" onclick="showMsg('رتب والألقاب', 'هنا كود التصنيف')"></div>

        <!-- صندوق المكافآت اليومية -->
        <div class="hotspot btn-daily-chest" onclick="showMsg('المكافأة اليومية', 'تم فتح الصندوق! حصلت على 500 ذهب.')"></div>

        <!-- الزر الرئيسي (ابدأ المواجهة) -->
        <div class="hotspot btn-start-match" onclick="openGame()"></div>

        <!-- الأزرار السفلية الثلاثة -->
        <div class="hotspot btn-play-online" onclick="showMsg('أونلاين', 'اللعب مع العالم قريباً')"></div>
        <div class="hotspot btn-play-ai" onclick="openGame()"></div>
        <div class="hotspot btn-challenges" onclick="showMsg('التحديات الكبرى', 'هنا كود التحديات')"></div>

        <!-- شريط التنقل السفلي -->
        <div class="hotspot btn-nav-store" onclick="showMsg('المتجر', 'هنا كود المتجر')"></div>
        <div class="hotspot btn-nav-inventory" onclick="showMsg('المخزون', 'هنا كود المخزون')"></div>
        <div class="hotspot btn-nav-profile" onclick="showMsg('حسابي', 'هنا كود الحساب')"></div>
        <div class="hotspot btn-nav-home" onclick="showMsg('الرئيسية', 'أنت في الصفحة الرئيسية')"></div>

    </div>

    <script>
        // ⚠️ 1. دالة فتح اللعبة (تتصل بملف game.html)
        function openGame() {
            // تأكد أن ملف اللعبة اسمه game.html وموجود بنفس المجلد
            window.location.href = "game.html"; 
        }

        // ⚠️ 2. دالة فتح الإعدادات (تتصل بملف settings.html)
        function openSettings() {
            // إذا كان لديك ملف للإعدادات، ضع اسمه هنا بدل التنبيه
            // window.location.href = "settings.html";
            showMsg('الإعدادات', 'هنا تضع كود صفحة الإعدادات (الصوت، اللغة، إلخ)');
        }

        // 3. دالة مساعدة لإظهار رسالة للأزرار التي لم يتم برمجتها بعد
        function showMsg(title, message) {
            alert("🔔 " + title + "\n\n" + message);
        }
    </script>
</body>
</html>
